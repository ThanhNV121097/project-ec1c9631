# Compose PostgreSQL user.
POSTGRES_USER=app
# Compose PostgreSQL password. Replace outside development.
POSTGRES_PASSWORD=app_secret
# Compose PostgreSQL database name.
POSTGRES_DB=app
# Host port for backend.
BACKEND_PORT=8080
# Host port for frontend.
FRONTEND_PORT=3000
# Browser-visible backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-side frontend API origin.
API_ORIGIN=http://backend:8080
